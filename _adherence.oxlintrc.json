{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/**",
              "ui_kits/dashboard/**",
              "ui_kits/referral/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans Thai|Inter|Loma|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans Thai, Inter, Loma, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertAlert02'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<AlertAlert02> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|actionButton|alertStatus|label|text1|text2|icon1|key|ref|className|style|children)$/]",
        "message": "<AlertBanner> doesn't accept that prop. Declared props: className, style, actionButton, alertStatus, label, text1, text2, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute[name.name='alertStatus'] > Literal[value!=/^(?:info|success|warning|danger)$/]",
        "message": "<AlertBanner> alertStatus must be one of 'info' | 'success' | 'warning' | 'danger'."
